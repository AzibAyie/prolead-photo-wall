rules_version = '2';

// Firestore security rules for the ProLead photo wall (deployed with `firebase deploy --only firestore:rules`).
// The admin list must match adminEmails in js/firebase-config.js.
//
// What these rules protect against:
//  - nobody but the admin can approve, hide, edit or delete photos
//  - visitors only ever see APPROVED photos; pending/rejected ones stay private
//  - every new post is checked field by field (no hidden code, no fake "photos", no oversized data)
//  - each visitor can post at most once every 30 seconds
//  - reactions can only go up or down by one, and only on approved photos
//  - reports can be sent by anyone but only read by the admin
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // the two admins must use their email + password accounts (anonymous visitors never count)
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in ['iamazibsafwan@gmail.com', 'adamridhwansafie12@gmail.com'];
    }

    function validNewPost(d) {
      return d.keys().hasOnly(['title','category','description','displayName','anonymous','group','challenge','reactions','image','date','status','uid'])
        && d.uid == request.auth.uid
        && d.status == 'pending'
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.category in ['arrival','icebreak','debate','questrace','integrity','groups','cultural','closing']
        && d.description is string && d.description.size() <= 280
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 40
        && d.anonymous is bool
        && d.group is string && d.group.matches('^[1-9]?$')
        && d.challenge is string && d.challenge.matches('^[a-z]{0,20}$')
        && d.reactions == {'heart': 0, 'laugh': 0, 'fire': 0, 'crown': 0}
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$')
        && d.image is string && d.image.size() < 160000
        && d.image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
    }

    // the post must be written together with this visitor's rate-limit stamp (see /limits)
    function stampedNow() {
      return getAfter(/databases/$(database)/documents/limits/$(request.auth.uid)).data.lastPost == request.time;
    }

    // ---- reactions: ONE per person per photo ----
    // Each person's choice is kept in /votes/{postId}_{uid}. The counts on the photo may only change
    // to match that vote: +1 when it's added, -1 when it's removed, or -1/+1 when it's switched.
    function votePath(postId) {
      return /databases/$(database)/documents/votes/$(postId + '_' + request.auth.uid);
    }
    function postPath(postId) {
      return /databases/$(database)/documents/posts/$(postId);
    }
    function countsMatch(before, after, add, sub) {
      return after.keys().hasOnly(['heart','laugh','fire','crown'])
        && after.keys().hasAll(['heart','laugh','fire','crown'])
        && after.heart == before.heart + (add == 'heart' ? 1 : 0) - (sub == 'heart' ? 1 : 0)
        && after.laugh == before.laugh + (add == 'laugh' ? 1 : 0) - (sub == 'laugh' ? 1 : 0)
        && after.fire  == before.fire  + (add == 'fire'  ? 1 : 0) - (sub == 'fire'  ? 1 : 0)
        && after.crown == before.crown + (add == 'crown' ? 1 : 0) - (sub == 'crown' ? 1 : 0)
        && after.heart >= 0 && after.laugh >= 0 && after.fire >= 0 && after.crown >= 0;
    }
    function validReaction(postId) {
      let had = exists(votePath(postId));
      let has = existsAfter(votePath(postId));
      let oldR = had ? get(votePath(postId)).data.r : '';
      let newR = has ? getAfter(votePath(postId)).data.r : '';
      return signedIn()
        && resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && oldR != newR
        && countsMatch(resource.data.reactions, request.resource.data.reactions, newR, oldR);
    }
    // the matching count change on the photo must happen in the same save
    function countMoved(postId, r, by) {
      return getAfter(postPath(postId)).data.reactions[r] == get(postPath(postId)).data.reactions[r] + by;
    }

    // photo info + small thumbnail
    match /posts/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if signedIn() && validNewPost(request.resource.data) && stampedNow();
      allow update: if isAdmin() || validReaction(id);
      allow delete: if isAdmin();
    }

    // full-size photo, created together with its post by the same visitor
    match /images/{id} {
      allow read: if isAdmin() || get(/databases/$(database)/documents/posts/$(id)).data.status == 'approved';
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['full'])
        && request.resource.data.full is string && request.resource.data.full.size() < 950000
        && request.resource.data.full.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && getAfter(/databases/$(database)/documents/posts/$(id)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/posts/$(id)).data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // each person's single reaction on a photo (id = postId_uid)
    match /votes/{voteId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['post','uid','r'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.post is string
        && voteId == request.resource.data.post + '_' + request.auth.uid
        && request.resource.data.r in ['heart','laugh','fire','crown']
        && countMoved(request.resource.data.post, request.resource.data.r, 1);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['r'])
        && request.resource.data.r in ['heart','laugh','fire','crown']
        && countMoved(resource.data.post, request.resource.data.r, 1)
        && countMoved(resource.data.post, resource.data.r, -1);
      allow delete: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && countMoved(resource.data.post, resource.data.r, -1));
    }

    // one upload every 30 seconds per visitor
    match /limits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastPost'])
        && request.resource.data.lastPost == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastPost'])
        && request.resource.data.lastPost == request.time
        && request.time > resource.data.lastPost + duration.value(30, 's');
    }

    // "Report this photo": anyone signed in can send one, only the admin can read or clear them
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['postId','reason','uid','date'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string && request.resource.data.postId.size() <= 40
        && request.resource.data.reason in ['inappropriate','privacy','spam','other']
        && request.resource.data.date == request.time;
      allow read, delete: if isAdmin();
    }

    // site settings: everyone can read the chosen background song, only the admin can change it
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin() && doc == 'site'
        && request.resource.data.keys().hasOnly(['song'])
        && request.resource.data.song in ['berapa-kali', 'sesi-potret', 'carefree', 'wholesome', 'heroic-age', 'fluffing-a-duck', 'monkeys-spinning'];
    }

    // committee photos uploaded by the admin (they replace the built-in photos); everyone can see them
    match /team/{key} {
      allow read: if true;
      allow create, update: if isAdmin()
        && key.matches('^[a-z0-9-]{1,80}$')
        && request.resource.data.keys().hasOnly(['photo'])
        && request.resource.data.photo is string && request.resource.data.photo.size() < 600000
        && request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
      allow delete: if isAdmin();
    }

    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
